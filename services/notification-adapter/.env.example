# Plane 工作空间 Webhook 创建后显示的签名密钥（不是 API Token）
PLANE_WEBHOOK_SECRET=
PLANE_BASE_URL=https://plane.example.com
# 消息中的品牌名称；钉钉发送者名称需在群机器人设置中修改。
NOTIFICATION_BRAND=星轴研发
# 至少配置一个平台；两个平台同时配置时会同时发送。
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_SIGN_SECRET=
# 默认仅推送工作项、评论；其他可选事件：project,module,cycle,cycle_issue,module_issue
PLANE_EVENTS=issue,issue_comment
# 可选：项目 UUID，逗号分隔。为空时不过滤项目。
PLANE_PROJECT_IDS=
# Docker 自动读取 /app/config/routes.json；不创建该文件则沿用上面的默认群。
# 本机 Python 运行时可以指定：ROUTES_FILE=services/notification-adapter/config/routes.json
